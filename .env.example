# AI runtime
AI_ENABLED=true
# Set to claude to use Anthropic; otherwise use LLM_PROVIDER.
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Existing provider fallback examples
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Capability flags
AI_LOCATOR_GENERATION=true
AI_LOCATOR_HEALING=true
AI_TEST_GENERATION=true
AI_FAILURE_ANALYSIS=true
